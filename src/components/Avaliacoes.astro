---
/**
 * Avaliações, dirigidas por AVALIACOES (src/data/site.ts). Regras CFO/Google:
 * - nunca depoimento fictício; só trechos reais do Google, sobre o atendimento, com autorização, sem foto;
 * - sem AggregateRating/Review no JSON-LD.
 * Sem trechos: convite para ler as avaliações de pacientes no Google (link para o perfil).
 */
import SecaoTitulo from './SecaoTitulo.astro';
import { AVALIACOES, SITE, ENDERECO } from '../data/site';
import { dataCurta } from '../lib/format';

interface Props {
  titulo?: string;
  eyebrow?: string;
  id?: string;
  nivel?: 2 | 3;
  class?: string;
}
const { titulo = 'Avaliações no *Google*.', eyebrow, id = 'aval-t', nivel = 2, class: classe } = Astro.props;

// CONFIRMAR: AVALIACOES.googleUrl (link "ver avaliações" do Perfil da Empresa). Até lá, busca pelo nome no Google Maps.
const url =
  AVALIACOES.googleUrl ??
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${SITE.nome} ${ENDERECO.cidade}`)}`;
const temTrechos = AVALIACOES.trechos.length > 0;
---

<div class:list={['aval', classe]}>
  <SecaoTitulo texto={titulo} eyebrow={eyebrow} id={id} nivel={nivel} />
  {
    AVALIACOES.nota && (
      <p class="nota" data-r>
        <span class="nota-n">{AVALIACOES.nota}</span>
        <span class="nota-s">
          <span class="stars" aria-hidden="true">
            ★★★★★
          </span>
          <span>
            {AVALIACOES.total ? `Nota no Google, ${AVALIACOES.total} avaliações` : 'Nota no Google'}
          </span>
        </span>
      </p>
    )
  }
  {
    temTrechos ? (
      <ul class="quotes" data-r>
        {AVALIACOES.trechos.map((t) => (
          <li>
            <blockquote cite={url}>
              <p>{t.texto}</p>
            </blockquote>
            <p class="q-by">
              {t.autor}
              {t.data && <span>· {dataCurta(t.data)}</span>}
              <span class="tag">Avaliação no Google</span>
            </p>
          </li>
        ))}
      </ul>
    ) : (
      <div class="aval-convite" data-r>
        <p class="aval-titulo">Avaliações de pacientes no Google</p>
        <p>
          As avaliações ficam onde devem estar: no Perfil da Empresa no Google, escritas por quem foi atendido, do jeito que
          foram publicadas.
        </p>
      </div>
    )
  }
  <a class="lnk" href={url} target="_blank" rel="noopener" aria-label="Ler as avaliações no Google (abre em nova aba)">
    Ler as avaliações no Google
    <svg class="i i-ne" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><use href="#i-ne"></use></svg>
  </a>
</div>

<style is:global>
  .nota{display:flex;flex-wrap:wrap;align-items:center;gap:12px 18px;margin-top:28px;max-width:none}
  .nota-n{font:400 clamp(4.5rem,7vw,6rem)/.9 var(--serif);letter-spacing:-.02em}
  .nota-s{display:grid;gap:8px;font-size:.9375rem;color:var(--verde-2)}
  .stars{font-size:1.125rem;letter-spacing:.18em;line-height:1;color:var(--verde)}
  .quotes{margin:36px 0 20px;border-top:1px solid var(--rule)}
  .quotes li{padding:22px 0;border-bottom:1px solid var(--rule)}
  .quotes blockquote{padding-left:20px;border-left:2px solid var(--polen);font-size:1.25rem;line-height:1.45}
  .q-by{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin-top:12px;padding-left:22px;font-size:.9375rem;color:var(--verde-2)}
  .aval-convite{margin:36px 0 16px;padding:26px 0 30px;border-block:1px solid var(--rule)}
  .aval-titulo{margin-bottom:14px;font:400 1rem/1.3 var(--caps);letter-spacing:.08em;color:var(--verde-2)}
  .aval-convite p:not(.aval-titulo){max-width:30ch;padding-left:20px;border-left:2px solid var(--polen);font:400 clamp(1.5rem,1.25rem + .8vw,1.9rem)/1.3 var(--serif);letter-spacing:-.005em}
</style>
