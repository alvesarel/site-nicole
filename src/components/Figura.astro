---
/**
 * Figura editorial: <Picture> (AVIF/WebP + JPG), legenda "FIG. 0X", moldura deslocada opcional
 * e revelação em cortina abaixo da dobra.
 * ⚠️ Acima da dobra use `prioridade` (eager + fetchpriority high, sem revelação) e gere o preload
 *    com preloadImagem() de src/lib/imagem.ts usando os mesmos `sizes`/`widths`.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { larguras, QUALIDADE } from '../lib/imagem';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Número da figura (vira "FIG. 03"). */
  fig?: number | string;
  legenda?: string;
  /** sizes do srcset — sempre informe o tamanho real de exibição. */
  sizes: string;
  widths?: number[];
  /** aspect-ratio da área da imagem (ex.: "4/5", "3/2"). Padrão: proporção original. */
  proporcao?: string;
  /** object-position (ex.: "56% 24%"). */
  posicao?: string;
  /** Moldura em linha deslocada (lâmina). */
  moldura?: boolean;
  /** Revelação em cortina ao entrar na tela (padrão: sim, exceto com prioridade). */
  revelar?: boolean;
  /** Imagem acima da dobra / LCP. */
  prioridade?: boolean;
  /** fetchpriority="high" no <img> (padrão: igual a `prioridade`). Use false quando o preload já cuida disso. */
  altaPrioridade?: boolean;
  /** Atraso da revelação em ms. */
  atraso?: number;
  /** Qualidade (padrão QUALIDADE de src/lib/imagem.ts; se mudar no hero, mude também no preload). */
  quality?: number;
  class?: string;
}

const {
  src,
  alt,
  fig,
  legenda,
  sizes,
  widths,
  proporcao,
  posicao,
  moldura = false,
  revelar = true,
  prioridade = false,
  altaPrioridade,
  atraso,
  quality = QUALIDADE,
  class: classe,
} = Astro.props;

const ws = widths ?? larguras(src);
const fp = (altaPrioridade ?? prioridade) ? 'high' : undefined;
const num = fig === undefined ? undefined : typeof fig === 'number' ? String(fig).padStart(2, '0') : fig;
const estiloFig = [proporcao && `aspect-ratio:${proporcao}`, posicao && `--pos:${posicao}`].filter(Boolean).join(';');
const reveal = revelar && !prioridade ? 'clip' : undefined;
const estiloRoot = atraso ? `--d:${atraso}ms` : undefined;
---

<figure class:list={['fig', moldura && 'lamina', classe]} data-r={reveal} style={estiloRoot}>
  {
    moldura ? (
      <div class="lamina-quadro">
        <div class="fig-in" style={estiloFig || undefined}>
          <Picture
            src={src}
            alt={alt}
            widths={ws}
            sizes={sizes}
            formats={['avif', 'webp']}
            quality={quality}
            loading={prioridade ? 'eager' : 'lazy'}
            decoding={prioridade ? 'sync' : 'async'}
            fetchpriority={fp}
          />
        </div>
      </div>
    ) : (
      <div class="fig-in" style={estiloFig || undefined}>
        <Picture
          src={src}
          alt={alt}
          widths={ws}
          sizes={sizes}
          formats={['avif', 'webp']}
          quality={quality}
          loading={prioridade ? 'eager' : 'lazy'}
          decoding={prioridade ? 'sync' : 'async'}
          fetchpriority={fp}
        />
      </div>
    )
  }
  {
    (num || legenda) && (
      <figcaption>
        {num && <span class="fn">FIG. {num}</span>}
        {legenda && <span>{legenda}</span>}
      </figcaption>
    )
  }
</figure>
