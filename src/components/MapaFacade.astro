---
/**
 * Mapa em "facade": ilustração SVG leve na paleta (aspect-ratio fixo, zero CLS) + botão
 * "Ver mapa interativo", que carrega o MapLibre (npm maplibre-gl, import dinâmico) com o estilo
 * OpenFreeMap Positron recolorido. Se falhar, cai para o iframe do Google Maps.
 * Os links de rota (Google Maps, Waze, Apple Maps) ficam sempre visíveis. Sem JS: só facade + links.
 */
import { ENDERECO, SITE } from '../data/site';
import { enderecoUmaLinha } from '../lib/format';

interface Props {
  id?: string;
  fig?: number | string;
  legenda?: string;
  links?: boolean;
  class?: string;
}
const {
  id = 'mapa',
  fig = 5,
  legenda = 'O mapa interativo carrega só quando você pede',
  links = true,
  class: classe,
} = Astro.props;

const num = typeof fig === 'number' ? String(fig).padStart(2, '0') : fig;
const rua = ENDERECO.rua.replace(/,\s*\d.*$/, '');
const consulta = `${ENDERECO.ruaCompleta}, ${ENDERECO.cidade} - ${ENDERECO.uf}`;
const rotas = [
  { nome: 'Google Maps', href: ENDERECO.googleMapsUrl },
  { nome: 'Waze', href: ENDERECO.wazeUrl },
  { nome: 'Apple Maps', href: ENDERECO.appleMapsUrl },
];
---

<div class:list={['mapa', classe]}>
  <figure data-r="clip">
    <div
      class="map fig-in"
      id={id}
      data-mapa
      data-lat={ENDERECO.geo.lat}
      data-lng={ENDERECO.geo.lng}
      data-zoom="15"
      data-q={consulta}
      data-rotulo={`${ENDERECO.rua}, ${ENDERECO.bairro}`}
      data-nome={`Consultório da ${SITE.nome}`}
    >
      <svg class="map-svg" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`Ilustração do mapa do ${ENDERECO.bairro}, com o pin do consultório na ${rua}`}>
        <defs>
          <pattern id={`${id}-ruas`} width="58" height="72" patternUnits="userSpaceOnUse">
            <path d="M58 0V72M0 72H58" fill="none" stroke="#3D420A" stroke-opacity=".22" stroke-width="1.3"></path>
          </pattern>
        </defs>
        <rect width="800" height="500" fill="#FFFDEE"></rect>
        <g transform="rotate(-27 400 250)">
          <rect x="-500" y="-500" width="1800" height="1500" fill={`url(#${id}-ruas)`}></rect>
          <path d="M120 120h174v216H120zM526 318h116v144H526z" fill="#F5F1DA"></path>
          <path d="M-300 105H1100M-300 393H1100M178 -400V900M642 -400V900" fill="none" stroke="#3D420A" stroke-opacity=".22" stroke-width="7"></path>
          <path id={`${id}-rua`} d="M-300 250H1100" fill="none" stroke="#3D420A" stroke-opacity=".6" stroke-width="2.4"></path>
          <text font-family="Arsenal SC, Georgia, serif" font-size="26" letter-spacing="2" fill="#3D420A" dy="-12" text-anchor="end">
            <textPath href={`#${id}-rua`} startOffset="46%">{rua}</textPath>
          </text>
        </g>
        <path d="M612 -20c40 52 112 62 170 34 34-16 52 70 34 118-36 92-150 82-196 30-30-34-48-112-8-182z" fill="#DEE2FF"></path>
        <circle class="pulse" cx="400" cy="250" r="30" fill="none" stroke="#DBCB79" stroke-width="2"></circle>
        <circle cx="400" cy="250" r="19" fill="#FFFDEE" stroke="#DBCB79" stroke-width="2"></circle>
        <circle cx="400" cy="250" r="10" fill="#3D420A"></circle>
        <text x="96" y="96" font-family="Arsenal SC, Georgia, serif" font-size="30" letter-spacing="7" fill="#3D420A">{ENDERECO.bairro}</text>
      </svg>
      <div class="map-canvas" hidden></div>
      <p class="sr" role="status" data-map-status></p>
      <button class="btn map-btn" type="button" data-map-btn>Ver mapa interativo</button>
    </div>
    <figcaption>
      <span class="fn">FIG. {num}</span><span>{legenda}</span>
    </figcaption>
  </figure>
  {
    links && (
      <ul class="map-links" aria-label={`Rotas até ${enderecoUmaLinha()}`}>
        {rotas.map((r) => (
          <li>
            <a class="lnk" href={r.href} target="_blank" rel="noopener" aria-label={`Abrir rota no ${r.nome} (abre em nova aba)`}>
              {r.nome}
              <svg class="i i-ne" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
                <use href="#i-ne" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<script>
  import '../scripts/mapa';
</script>

<style is:global>
  .map{position:relative;aspect-ratio:4/3;overflow:hidden;background:var(--creme);border:1px solid var(--rule)}
  .map-svg,.map-canvas,.map iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .map-canvas[hidden]{display:none}
  .map-btn{position:absolute;left:50%;bottom:22px;z-index:2;translate:-50% 0;white-space:nowrap}
  .map-btn[disabled]{cursor:progress;opacity:.92}
  .map.is-live .map-btn,.map.is-live .map-svg{display:none}
  .map-pin{width:22px;height:22px;border-radius:50%;background:var(--verde);box-shadow:0 0 0 6px rgb(219 203 121/.6),0 0 0 7px rgb(61 66 10/.35)}
  .pulse{transform-box:fill-box;transform-origin:center}
  .map-links{display:flex;flex-wrap:wrap;gap:0 28px;margin-top:8px}
  .map .maplibregl-ctrl-attrib{font:400 12px/1.4 var(--sans)}
  /* alvos de toque ≥ 44 px nos controles do MapLibre */
  .map .maplibregl-ctrl-group button{width:44px;height:44px}
  .map .maplibregl-ctrl-attrib-button{width:44px;height:44px;background-position:center}
  @media (prefers-reduced-motion:no-preference){.pulse{animation:pulse 2.6s var(--ease) infinite}}
  @keyframes pulse{0%{transform:scale(.55);opacity:1}100%{transform:scale(1.7);opacity:0}}
  @media (min-width:700px){.map{aspect-ratio:16/11}}
  html:not(.js) .map-btn{display:none}
</style>
