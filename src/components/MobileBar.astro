---
/**
 * Barra fixa do mobile (< 720px): "Click para agendar" + ligar.
 * Aparece sempre que o CTA marcado com data-hero-cta está fora da tela (ou, sem ele, após ~1 tela de rolagem)
 * e some quando um elemento com data-bar-stop entra (rodapé, seção de endereço/contato).
 * Sem JS fica sempre visível (o rodapé ganha folga embaixo).
 */
import { whatsappUrl, CTA_TEXTO, CTA_ARIA } from '../data/site';
import { telHref, telAria } from '../lib/format';

interface Props {
  origem: string;
}
const { origem } = Astro.props;
---

<aside class="mbar" data-mbar aria-label="Agendamento rápido">
  <a class="mbar-cta" href={whatsappUrl(origem)} target="_blank" rel="noopener" aria-label={CTA_ARIA}>
    {CTA_TEXTO}
    <svg class="i" viewBox="0 0 20 10" aria-hidden="true" focusable="false"><use href="#i-ar"></use></svg>
  </a>
  <a class="mbar-tel" href={telHref} aria-label={telAria}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#i-tel"></use></svg>
  </a>
</aside>
