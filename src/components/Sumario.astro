---
/**
 * Sumário "Nesta página" (links para os H2). <details>: recolhido no mobile, aberto no desktop
 * (um script mínimo abre a partir de 1024px; sem JS fica recolhido e continua clicável).
 * Coloque dentro de um grid com a classe .leitura (sumário à esquerda, texto à direita).
 */
interface Props {
  itens: { slug: string; text: string }[];
  titulo?: string;
}
const { itens, titulo = 'Nesta página' } = Astro.props;
---

<nav class="toc" aria-labelledby="toc-t">
  <details class="toc-d" data-toc>
    <summary id="toc-t">
      {titulo} <span class="toc-n">{itens.length} tópicos</span>
    </summary>
    <ol>
      {
        itens.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))
      }
    </ol>
  </details>
</nav>

<script>
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
  if (toc && matchMedia('(min-width: 1024px)').matches) toc.open = true;
</script>

<style is:global>
  .leitura{display:grid;gap:40px}
  .toc{align-self:start}
  .toc-d{border-block:1px solid var(--rule)}
  .toc summary{display:flex;align-items:center;gap:16px;min-height:56px;cursor:pointer;list-style:none;font:400 1rem/1.3 var(--caps);letter-spacing:.08em}
  .toc summary::-webkit-details-marker{display:none}
  .toc summary::after{content:"+";width:1em;text-align:center;font:300 1.5rem/1 var(--sans)}
  .toc-d[open] summary::after{content:"–"}
  .toc-n{margin-left:auto;font:400 .9375rem/1.3 var(--sans);letter-spacing:0;color:var(--verde-2)}
  .toc ol{padding-bottom:12px}
  .toc li a{display:flex;align-items:center;min-height:44px;padding:6px 0;font-size:1rem;line-height:1.4;text-decoration:none}
  .toc li a:hover{text-decoration:underline;text-decoration-color:rgb(61 66 10/.45)}
  .leitura-txt>.prose>h2:first-child{margin-top:0}
  @media (min-width:1024px){
    .leitura{grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px}
    .toc{grid-column:1/4;position:sticky;top:calc(var(--hdr) + 28px)}
    .toc-d[open] summary{cursor:default}
    .toc-d[open] summary::after{display:none}
    .leitura-txt{grid-column:5/13}
  }
</style>
