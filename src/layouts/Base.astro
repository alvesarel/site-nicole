---
/**
 * Layout base de todas as páginas.
 * <head> completo (SEO, Open Graph/Twitter, ícones, preload de fontes e da imagem LCP, JSON-LD @graph,
 * speculation rules), skip link, Header, <main id="conteudo">, Footer e barra fixa do mobile.
 *
 * JSON-LD: WebSite + Dentist + Person + WebPage entram sempre; BreadcrumbList entra quando há `breadcrumbs`;
 * acrescente Service/FAQPage etc. pela prop `jsonLd` (funções em src/lib/schema.ts).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../data/site';
import { SPRITE_LOGO_ID, SPRITE_LOGO_INNER } from '../lib/logo';
import { dataIso } from '../lib/format';
import type { PreloadImagem } from '../lib/imagem';
import {
  websiteNode,
  dentistNode,
  personNode,
  webPageNode,
  breadcrumbListNode,
  grafo,
  urlAbsoluta,
  type NoJsonLd,
} from '../lib/schema';

interface Props {
  /** <title> completo, até 60 caracteres. */
  title: string;
  /** Meta description, até 155 caracteres. */
  description: string;
  /** Caminho canônico com barra final, ex. "/servicos/protese-dentaria/". */
  path: string;
  /** Origem do CTA (vai na mensagem do WhatsApp), ex. "Home", "Prótese dentária". */
  origem: string;
  /** Imagem social (caminho em public/ ou URL absoluta, 1200×630). */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Nós extras do @graph (Service, FAQPage…). */
  jsonLd?: NoJsonLd[];
  /** Trilha sem "Início" (é acrescentado). O último item é a página atual. */
  breadcrumbs?: { nome: string; href: string }[];
  /** Preload da imagem LCP: use preloadImagem() de src/lib/imagem.ts. */
  preload?: PreloadImagem;
  /** Fontes a pré-carregar (arquivos em public/fonts). Só as usadas acima da dobra. */
  fontes?: string[];
  noindex?: boolean;
  /** Data de atualização do conteúdo (rodapé + JSON-LD). Padrão: SITE.revisadoEm. */
  atualizadoEm?: Date | string;
  /** Tipo schema.org da página (WebPage, AboutPage, ContactPage, FAQPage, CollectionPage, MedicalWebPage). */
  tipoPagina?: string;
  /** @id da entidade principal (mainEntity do WebPage), ex.: IDS.nicole. */
  principal?: string;
  /** Oculta a barra fixa do mobile (ex.: página de contato já cheia de CTAs). */
  semBarraMobile?: boolean;
}

const {
  title,
  description,
  path,
  origem,
  ogImage = SITE.ogImagem,
  ogImageAlt = `${SITE.nome}, cirurgiã-dentista no Cambuí, Campinas`,
  ogType = 'website',
  jsonLd = [],
  breadcrumbs,
  preload,
  fontes = ['bodoni-moda', 'bricolage-grotesque'],
  noindex = false,
  atualizadoEm = SITE.revisadoEm,
  tipoPagina = 'WebPage',
  principal,
  semBarraMobile = false,
} = Astro.props;

const canonical = urlAbsoluta(path);
const ogUrl = urlAbsoluta(ogImage);
const trilha = breadcrumbs?.length ? [{ nome: 'Início', href: '/' }, ...breadcrumbs] : undefined;

const nos: NoJsonLd[] = [
  websiteNode(),
  dentistNode(),
  personNode(),
  webPageNode({ path, titulo: title, descricao: description, atualizadoEm, tipo: tipoPagina, principal }),
  ...(trilha ? [breadcrumbListNode(trilha, path)] : []),
  ...jsonLd,
];

const especulacao = JSON.stringify({
  prefetch: [
    {
      source: 'document',
      where: {
        and: [{ href_matches: '/*' }, { not: { selector_matches: '[target=_blank], [download], [rel~=nofollow]' } }],
      },
      eagerness: 'moderate',
    },
  ],
});

if (import.meta.env.DEV) {
  if (title.length > 60) console.warn(`[Base] title com ${title.length} caracteres (> 60): ${title}`);
  if (description.length > 155) console.warn(`[Base] description com ${description.length} caracteres (> 155): ${path}`);
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#FFFDEE" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {fontes.map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)}
    {
      preload && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          type={preload.type}
          media={preload.media}
          fetchpriority="high"
          href={preload.href}
        />
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && <meta property="article:modified_time" content={dataIso(atualizadoEm)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" is:inline set:html={grafo(nos)} />
    <script type="speculationrules" is:inline set:html={especulacao} />
  </head>
  <body>
    <svg class="sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <g id={SPRITE_LOGO_ID} set:html={SPRITE_LOGO_INNER} />
        <symbol id="i-ar" viewBox="0 0 20 10"><path d="M0 5h18.5M14.5 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2"></path></symbol>
        <symbol id="i-ne" viewBox="0 0 10 10"><path d="M1.5 8.5l7-7M3 1.5h5.5V7" fill="none" stroke="currentColor" stroke-width="1.1"></path></symbol>
        <symbol id="i-tel" viewBox="0 0 24 24"><path d="M6.6 3.5h3l1.5 4.2-2 1.3a11 11 0 0 0 5.9 5.9l1.3-2 4.2 1.5v3a2 2 0 0 1-2.1 2A16.5 16.5 0 0 1 4.6 5.6a2 2 0 0 1 2-2.1z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></symbol>
      </defs>
    </svg>
    <span class="sentinel" aria-hidden="true"></span>
    <span class="mbar-ref" aria-hidden="true"></span>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>

    <Header origem={origem} />

    <main id="conteudo">
      {
        trilha && (
          <div class="wrap">
            <Breadcrumbs itens={trilha} />
          </div>
        )
      }
      <slot />
    </main>

    <Footer origem={origem} atualizadoEm={atualizadoEm} />
    {!semBarraMobile && <MobileBar origem={origem} />}

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
