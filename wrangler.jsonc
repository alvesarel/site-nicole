// Cloudflare Workers (static assets). Deploy: conectar o repositório em
// Workers & Pages → Create → Import a repository; build "npm run build"; deploy "npx wrangler deploy".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-nicole",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
